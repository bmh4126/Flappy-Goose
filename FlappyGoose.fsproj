<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FlappyGoose</RootNamespace>
    <AssemblyName>FlappyGoose</AssemblyName>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/GameTypes.fs" />
    <Compile Include="src/Constants.fs" />
    <Compile Include="src/Collision.fs" />
    <Compile Include="src/GameLogic.fs" />
    <Compile Include="src/Assets.fs" />
    <Compile Include="src/Rendering.fs" />
    <Compile Include="src/Program.fs" />
  </ItemGroup>

</Project>
